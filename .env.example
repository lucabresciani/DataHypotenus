# --- datahypotenus: configurazione ---
# Copiare in .env e adattare. Tutti i valori hanno un default sensato.

# Directory che contiene TUTTI i dati persistenti (db, allegati, backup, log).
# Relativa alla radice del progetto oppure assoluta.
# Windows:  DH_DATA_DIR=D:/datahypotenus-data
# Linux:    DH_DATA_DIR=/var/lib/datahypotenus
DH_DATA_DIR=./data

# Interfaccia di ascolto. 127.0.0.1 = solo questo PC (default, consigliato).
# Per l'accesso dalla LAN su un futuro server Linux: 0.0.0.0
DH_HOST=127.0.0.1
DH_PORT=8787

# Origini extra ammesse dal browser (CORS), separate da virgola.
# In sviluppo il server Vite (http://localhost:5173) e' gia' ammesso.
DH_CORS_ORIGINS=

# debug | info | warn | error
DH_LOG_LEVEL=info

# Dimensione massima di un singolo allegato, in MB.
DH_MAX_UPLOAD_MB=50

# Backup automatico all'avvio se l'ultimo e' piu' vecchio di N ore (0 = disattivato).
DH_AUTO_BACKUP_HOURS=24
# Numero di backup da conservare (i piu' vecchi vengono rimossi).
DH_BACKUP_KEEP=10
